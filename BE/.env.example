# Ścieżki danych i cache'u (domyślnie ./data wewnątrz BE/)
VIZ_DATA_DIR=./data
HF_HOME=./data/huggingface_cache

# Tryb pracy potoku ML (true = szybki test, false = pełne )
DRY_RUN=false
DRY_RUN_LIMIT=2048

# Tryb mock dla API (true = zwraca losowe współrzędne bez ładowania CLIP/UMAP)
MOCK_ML=false

# Strojenie wydajności pod lokalny sprzęt
BATCH_SIZE=1024
NUM_WORKERS=6

# Dozwolone domeny CORS dla Frontendu
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173